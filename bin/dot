#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.
export ZSH=$HOME/.dotfiles

# Upgrade appications and dependencies and other stuff
if test "$(uname)" = "Darwin"; then
  brew update
  brew upgrade
  brew upgrade --cask
  brew cleanup --prune=all
else
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
  sudo apt-get autoclean -y
fi

# tmux plugins (tpm itself is pulled by tmux/install.sh)
if [ -x "$HOME/.tmux/plugins/tpm/bin/update_plugins" ]; then
  "$HOME/.tmux/plugins/tpm/bin/update_plugins" all
fi

# prezto and its submodules; --ff-only fails safely if the clone has local edits
if [ -d "$HOME/.zprezto/.git" ]; then
  git -C "$HOME/.zprezto" pull --ff-only &&
    git -C "$HOME/.zprezto" submodule update --init --recursive
fi

# gem update
# gem clean
# yarn global upgrade
# headless Neovim can't get stuck on a "Press ENTER" prompt; plain Vim is the fallback
if command -v nvim >/dev/null 2>&1; then
  nvim --headless +PlugUpgrade '+PlugUpdate --sync' '+PlugClean!' +qa
  echo
else
  vim +PlugUpgrade +PlugUpdate +PlugClean +qa
fi