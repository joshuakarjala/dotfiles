#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname "$0")"/..
export ZSH="${ZSH:-$PWD}"

if test "$(uname -s)" = "Darwin"; then
  ./homebrew/install.sh
else
  ./apt-get/install.sh
fi

# find the remaining installers and run them in a stable order,
# reporting failures instead of silently swallowing them
failed=""
while IFS= read -r installer; do
  echo "==> $installer"
  sh "$installer" || { echo "!! $installer failed"; failed="$failed $installer"; }
done < <(find . -name install.sh -not -path './homebrew/*' -not -path './apt-get/*' -not -path '*/plugged/*' -not -path './.git/*' | sort)

if [ -n "$failed" ]; then
  echo "Failed installers:$failed"
  exit 1
fi
